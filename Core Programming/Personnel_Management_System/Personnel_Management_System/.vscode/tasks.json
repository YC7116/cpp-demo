{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",          // 指定C++标准
                "-I", "include",       // 告诉编译器去 include 文件夹找头文件
                "src/boss.cpp",        // 所有 .cpp 文件前都加上 src/
                "src/employee.cpp",
                "src/main.cpp",
                "src/manager.cpp",
                "src/staff.cpp",
                "src/worker_data.cpp",
                "src/worker_manager.cpp",
                "-o", "output/main.exe" // 生成的可执行文件放在 output 文件夹
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
