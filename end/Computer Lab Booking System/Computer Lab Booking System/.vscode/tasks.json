{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: g++ build all",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-Wall",
                "-Iinclude",
                "src/main.cpp",
                "src/admin.cpp",
                "src/Person.cpp",
                "src/student.cpp",
                "src/teacher.cpp",
                "src/File.cpp",
                "-o",
                "output/main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}